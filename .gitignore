# Environment / Secrets

# -------------------------

.env
.env.*
!.env.example

*.pem
*.key
*.crt

secrets/
credentials/
*.secret
secret.yaml
secrets.yaml

# Never commit API keys, tokens,

# passwords or cloud credentials.

